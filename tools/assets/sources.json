  "materials": {
    "repo": "kenney",
    "src": "materials/",
    "dest": "textures/",
    "suffixes": ["_1K-JPG_Color.jpg", "_1K-JPG_NormalGL.jpg", "_1K-JPG_Roughness.jpg"],
    "items": [
      "Metal049A",
      "Metal055A",
      "Metal046B",
      "Concrete034",
      "Concrete046",
      "Ground054",
      "Ground103",
      "Rock063",
      "Asphalt025C",
      "Tiles139"
    ]
  },
  "audio": {
    "repo": "sounds",
    "dest": "audio/",
    "manifest": "manifest.json",
    "note": "Kenney CC0 sample library. Ambience, creature voices and weather are synthesised at runtime instead - see client/audio/synth.ts.",
    "categories": {
      "impacts": 70,
      "digital-beeps": 60,
      "ui-clicks": 40,
      "rpg-quest": 30
    }
  }
}
