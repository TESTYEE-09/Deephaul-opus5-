      "props/american_football",
      "props/Drill_01",
      "props/WetFloorSign_01",
      "props/all_purpose_cleaner",
      "props/CheeseBox_01",
      "modern-urban/CashRegister_01",
      "modern-urban/CoffeeCart_01",
      "sci-fi/chemistry_set",
      "sci-fi/circuit_board",
      "sci-fi/classic_laptop",
      "sci-fi/combination_wrench",
      "sci-fi/bolt_cutters_01",
      "sci-fi/bench_vice_01",
      "sci-fi/ammo_box",
